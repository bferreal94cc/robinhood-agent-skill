# Local development only. Never commit a filled-in file.
# Load through your environment/secret manager; the app does not auto-load dotenv.
DASHBOARD_API_TOKEN=
STRATEGY_APPROVED=false
NOTIFICATIONS_ENABLED=false
SPYBOT_DATABASE_PATH=./var/spybot-dev.sqlite3
# Optional PostgreSQL DSN; when set, it overrides SPYBOT_DATABASE_PATH.
SPYBOT_DATABASE_URL=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Presence means configured_unverified. Collectors are not started by the API or worker.
UW_API_TOKEN=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional research integrations are not implemented in this slice.
OPENAI_API_KEY=
EXA_API_KEY=
